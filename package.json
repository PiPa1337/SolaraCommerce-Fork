{
  "name": "solara-commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "benchmark:export": "vitest run scripts/export-benchmark.test.ts --testTimeout=30000",
    "build": "corepack pnpm -r --if-present build",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check": "corepack pnpm check:repository && corepack pnpm format:check && corepack pnpm typecheck && corepack pnpm test",
    "check:repository": "node scripts/check-repository.mjs",
    "dev": "corepack pnpm --filter @solara/studio dev",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm --filter @solara/studio build && playwright test",
    "test:e2e:ci": "playwright test",
    "typecheck": "corepack pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
