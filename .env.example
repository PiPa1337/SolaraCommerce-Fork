# Variables opcionales para desarrollo y validación local.
# No coloques credenciales ni tokens reales en este archivo.

# Puerto del servidor local de sitios/exportaciones cuando se ejecuta
# packages/exporter/scripts/serve.mjs directamente. Opcional; por defecto 4174.
SOLARA_PORT=4174

# Ruta a un respaldo .solara.zip para pilot:preflight y pilot:export.
# Si se omite, los scripts usan el fixture de referencia.
# SOLARA_PILOT_PROJECT_ARCHIVE=C:\\ruta\\tienda.solara.zip

# Permite que release-e2e omita el build de Studio cuando el workflow ya lo hizo.
# Usarlo sólo en CI o en un checkout que ya tenga una build válida.
# SOLARA_SKIP_E2E_BUILD=1

# Activa la matriz Chromium + Firefox + WebKit en la suite release.
# PLAYWRIGHT_MULTI_BROWSER=1

# Activa las capturas manuales de revisión visual bajo test-results/visual-review.
# VISUAL_REVIEW_STAGE=local

# CI es provista por GitHub Actions y modifica reporter/timeouts de Playwright.
# No hace falta definirla localmente.
